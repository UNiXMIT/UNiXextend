       PROCEDURE DIVISION.

000005     CALL "processing"
00000C     PERFORM DISPLAY-WELCOME-SCREEN
000010     CALL "SQL-DISCONNECT"
000017     CANCEL "processing"
00001B     GOBACK.

       DISPLAY-WELCOME-SCREEN.
000025             PERFORM UNTIL 1 = 2
00002E                     INITIALIZE WS-MASTER-RECORD ERROR-MESSAGE ERROR-FLAG
000046                 ACCEPT CURRENT-DATE FROM DATE YYYYMMDD
00004C                 DISPLAY WELCOME-SCREEN
000068                 ACCEPT WELCOME-SCREEN
000075         IF WS-MASTER-ACCOUNT = 9999
00007F             EXIT PERFORM
000086         ELSE
000087                             CALL "INITIAL" USING WS-MASTER-RECORD ERROR-FLAG ERROR-MESSAGE
00009A                             PERFORM ERROR-HANDLING
00009E                             IF VALID
0000A7                 PERFORM MAIN-MENU
                                   ELSE
0000AE                                     DISPLAY "ACCOUNT DOESN'T EXIST!" AT 0625 ERASE SCREEN
0000B7                 DISPLAY "PRESS ENTER TO CONTINUE." AT 0825
0000C0                 ACCEPT OMITTED AT 0850
                                   END-IF
                           END-IF
                   END-PERFORM.

       MAIN-MENU.
0000D2     PERFORM UNTIL 1 = 2
0000DB                 DISPLAY MAIN-MENU
0000E9         ACCEPT MAIN-MENU
0000F6         EVALUATE USER-OPTION
                                   WHEN "1"
0000FF                                     PERFORM WITHDRAWL
                                   WHEN "2"
00010E                                     PERFORM DEPOSIT
                                   WHEN "3"
00011D                                     PERFORM ENQUIRY

.\ATM\ATM.sqb        Tue Feb 26 15:54:45 2019  ACUCOBOL-GT v10.2.1  Page: 0004


                                   WHEN "4"
00012C                                     EXIT PERFORM
                                   WHEN OTHER
000133                             DISPLAY "WRONG OPTION!" AT 1515
00013C                             DISPLAY "PRESS ENTER TO CONTINUE." AT 1715
000145                             ACCEPT OMITTED AT 1740
                           END-EVALUATE
           END-PERFORM.

       WITHDRAWL.
000157             MOVE "WITHDRAWL" TO MENU-TITLE
00015F             PERFORM UNTIL 1 = 2
000168                     INITIALIZE ENTER-AMOUNT RECEIPT-REQUIRED ERROR-MESSAGE ERROR-FLAG
00017B                 DISPLAY AMOUNT-SCREEN
000195                 ACCEPT AMOUNT-SCREEN
0001A3         EVALUATE ENTER-AMOUNT
                                   WHEN <= 0
0001AE                                     DISPLAY "AMOUNT CANNOT BE ZERO OR NEGATIVE!" AT 2420
0001B7                                     ACCEPT OMITTED AT 2455
                                   WHEN > WS-MASTER-BALANCE
0001CF                                     DISPLAY "INSUFFICIENT FUNDS! PRESS ENTER TO CONTINUE." AT 2420
0001D8                                     ACCEPT OMITTED AT 2465
0001E3                                     EXIT PERFORM
                                   WHEN OTHER
0001EA                                     PERFORM RECEIPT-CHECK
0001EE                                     CALL "WITHDRAWL" USING WS-MASTER-RECORD ENTER-AMOUNT RECEIPT-REQUIRED ERROR-MESSAGE ERROR
000209                                     PERFORM ERROR-HANDLING
00020D                                     EXIT PERFORM
               END-EVALUATE
           END-PERFORM.

       DEPOSIT.
000218             MOVE "DEPOSIT" TO MENU-TITLE
000220             PERFORM UNTIL 1 = 2
000229                     INITIALIZE ENTER-AMOUNT RECEIPT-REQUIRED ERROR-MESSAGE ERROR-FLAG
00023C                 DISPLAY AMOUNT-SCREEN
000256                 ACCEPT AMOUNT-SCREEN
000264         EVALUATE ENTER-AMOUNT
                                   WHEN <= 0
00026F                                     DISPLAY "AMOUNT CANNOT BE ZERO OR NEGATIVE!" AT 2420
000278                                     ACCEPT OMITTED AT 2455
                                   WHEN OTHER
000286                                     IF (ENTER-AMOUNT + WS-MASTER-BALANCE) >= 100000
000293                                             DISPLAY "TOO MUCH MONEY. OPEN AN ISA!" AT 2420
00029C                                             ACCEPT OMITTED AT 2455
0002AA                                     ELSE
0002AB                                         PERFORM RECEIPT-CHECK
0002AF                                         CALL "DEPOSIT" USING WS-MASTER-RECORD ENTER-AMOUNT RECEIPT-REQUIRED ERROR-MESSAGE ERR
0002CA                                             PERFORM ERROR-HANDLING
0002CE                                         EXIT PERFORM
                                           END-IF
               END-EVALUATE
           END-PERFORM.

       ENQUIRY.
0002D9             INITIALIZE TRANS-COUNT TRANSACTIONS ERROR-MESSAGE ERROR-FLAG
00032D             CALL "ENQUIRY" USING WS-MASTER-RECORD TRANS-COUNT TRANSACTIONS ERROR-MESSAGE ERROR-FLAG

.\ATM\ATM.sqb        Tue Feb 26 15:54:45 2019  ACUCOBOL-GT v10.2.1  Page: 0005


000348             PERFORM ERROR-HANDLING
00034C     PERFORM DISPLAY-TRANSACTION-SCREEN.

       RECEIPT-CHECK.
000354             PERFORM UNTIL 1 = 2
00035D                 DISPLAY "WOULD YOU LIKE A RECEIPT? Y/N" AT 2420
000366                 ACCEPT RECEIPT-REQUIRED AT 2450
000372                     IF RECEIPT-REQUIRED = "Y" OR "y"
000383             EXIT PERFORM
00038A         ELSE
00038B             IF NOT (RECEIPT-REQUIRED = "N" OR "n")
00039C                 DISPLAY "WRONG OPTION, TRY AGAIN!" AT 2420 ERASE SCREEN
0003A5                                     INITIALIZE RECEIPT-REQUIRED
0003AA                 ACCEPT OMITTED AT 2445
0003B9             ELSE
0003BA                 EXIT PERFORM
                   END-IF
               END-IF
           END-PERFORM.

       DISPLAY-TRANSACTION-SCREEN.
0003C5             EVALUATE TRANS-COUNT
                           WHEN <= 0
0003CE                             DISPLAY "NO TRANSACTIONS RECORDED!" AT 0625 ERASE SCREEN
0003D7                         DISPLAY "PRESS ENTER TO CONTINUE." AT 0825
0003E0                         ACCEPT OMITTED AT 0850
                       WHEN 1
0003F6                     DISPLAY TRANSACTION-SCREEN
000486                     DISPLAY "PRESS ENTER TO CONTINUE." AT 1218 ERASE END SCREEN
000490                         ACCEPT OMITTED AT 1443
                           WHEN 2
0004A7                             DISPLAY TRANSACTION-SCREEN
000537                     DISPLAY "PRESS ENTER TO CONTINUE." AT 1418 ERASE END SCREEN
000541                         ACCEPT OMITTED AT 1443
                           WHEN 3
000558                             DISPLAY TRANSACTION-SCREEN
0005E8                     DISPLAY "PRESS ENTER TO CONTINUE." AT 1618 ERASE END SCREEN
0005F2                         ACCEPT OMITTED AT 1643
                   END-EVALUATE.

       ERROR-HANDLING.
000602             IF NOT (ERROR-MESSAGE = SPACES)
00060B                     DISPLAY ERROR-MESSAGE AT 2420 ERASE END SCREEN
000614                     ACCEPT OMITTED AT 2455
00061F                     IF STOP-RUN
000628                          STOP RUN
                           END-IF
                   END-IF.


