00035A         IF WS-MASTER-ACCOUNT = 0
000363             DISPLAY "PLEASE ENTER AN ACCOUNT NUMBER" AT 1025 ERASE LINE
00036C             PERFORM SLEEP-TIMER
               ELSE
000373             MOVE WS-MASTER-ACCOUNT TO MASTER-ACCOUNT
                   EXEC SQL
                       SELECT
                           MASTER_NAME,
                           MASTER_STREET,
                           MASTER_CITY,
                           MASTER_STATE,
                           MASTER_ZIP,
                           MASTER_PHONE_AREA,
