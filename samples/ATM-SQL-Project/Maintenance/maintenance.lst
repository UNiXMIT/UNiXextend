       DROP-TABLE.
001212     EXEC SQL WHENEVER SQLERROR CONTINUE END-EXEC

               DROP TABLE CUSTOMER
001238     END-EXEC

               DROP TABLE TRANSACTIONS
00126A     END-EXEC


       CREATE-TABLE.
00127E     EXEC SQL
              CREATE TABLE CUSTOMER (
                   MASTER_ACCOUNT        INTEGER
                         CONSTRAINT MASTER_ACCOUNT PRIMARY KEY,
                   MASTER_NAME         CHAR(30),
                   MASTER_STREET       CHAR(30),
                   MASTER_CITY         CHAR(30),
                   MASTER_STATE        CHAR(02),
                   MASTER_ZIP          CHAR(10),
                   MASTER_PHONE_AREA   CHAR(03),
                   MASTER_PHONE_PREFIX CHAR(03),
                   MASTER_PHONE_BASE   CHAR(04),
                   MASTER_PHONE_EXT    CHAR(05),
                   MASTER_START_YYYY   CHAR(04),
                   MASTER_START_MM     CHAR(02),
                   MASTER_START_DD     CHAR(02),
                   MASTER_BALANCE      DECIMAL(7,2)
                   )
           END-EXEC

               CREATE TABLE TRANSACTIONS (
                   TRANS_ACCOUNT       INTEGER,
                   TRANS_YEAR          CHAR(04),
                   TRANS_MONTH         CHAR(02),
                   TRANS_DAY           CHAR(02),
                   TRANS_HOURS         CHAR(02),
                   TRANS_MINUTES       CHAR(02),
                   TRANS_SECONDS       CHAR(02),
                   TRANS_HUNDREDS      CHAR(02),
                   TRANS_TYPE          CHAR(01),
                   TRANS_AMOUNT        DECIMAL(7,2)
                   )
001300     END-EXEC.

       SQL-DISCONNECT.
001312     EXEC SQL COMMIT END-EXEC.
001333     EXEC SQL DISCONNECT ALL END-EXEC

