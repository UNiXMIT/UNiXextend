{{@PARAGRAPH:
      *
       Screen1-Pb-1-Ev-Cmd-Clicked.
           INITIALIZE WS-COUNT
           PERFORM UNTIL 1 = 2
               ADD 1 TO WS-COUNT
               IF Screen1-Ef-2-Value (WS-COUNT) = SPACES
                   SUBTRACT 1 FROM WS-COUNT
                   DISPLAY MESSAGE WS-COUNT " LINE(S) OF TEXT"
                   EXIT PARAGRAPH
               END-IF
           END-PERFORM
           .

@}}

