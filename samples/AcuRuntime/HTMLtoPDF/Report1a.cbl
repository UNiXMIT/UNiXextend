            IF PRINT-BUF-CHAR = " "
              STRING NEW-PRINT-DATA DELIMITED BY SPACES "&nbsp;"
                DELIMITED BY SIZE INTO NEW-PRINT-DATA
              END-STRING
              ADD 6 TO NEW-PRINT-DATA-SIZE
            ELSE
              STRING NEW-PRINT-DATA DELIMITED BY SPACES PRINT-BUF-CHAR
                DELIMITED BY SIZE INTO NEW-PRINT-DATA
              END-STRING
              ADD 1 TO NEW-PRINT-DATA-SIZE
            END-IF
            END-PERFORM
