       ACU-FORMAT-PRINT-BUF.
            INITIALIZE NEW-PRINT-DATA-SIZE PRINT-BUF-SIZE
              PRINT-BUF-LENGTH PRINT-BUF-TRAIL-SPACES
              PRINT-BUF-TOTAL-SPACES PRINT-BUF-COUNT
            SET PRINT-BUF-LENGTH TO LENGTH OF PRINT-BUF
            INSPECT PRINT-BUF TALLYING PRINT-BUF-TRAIL-SPACES FOR
              TRAILING SPACES
            INSPECT PRINT-BUF TALLYING PRINT-BUF-TOTAL-SPACES FOR ALL
              SPACES
            COMPUTE PRINT-BUF-SIZE = PRINT-BUF-LENGTH -
              PRINT-BUF-TRAIL-SPACES
            IF PRINT-BUF-SIZE = 0 OR PRINT-BUF-TOTAL-SPACES =
                PRINT-BUF-TRAIL-SPACES
              MOVE PRINT-BUF TO NEW-PRINT-DATA
              INSPECT NEW-PRINT-DATA REPLACING TRAILING SPACES BY
                LOW-VALUES
              EXIT PARAGRAPH
            END-IF
            INITIALIZE NEW-PRINT-DATA
            PERFORM VARYING PRINT-BUF-COUNT FROM 1 BY +1 UNTIL
              PRINT-BUF-COUNT > PRINT-BUF-SIZE OR NEW-PRINT-DATA-SIZE >
              PRINT-BUF-LENGTH
