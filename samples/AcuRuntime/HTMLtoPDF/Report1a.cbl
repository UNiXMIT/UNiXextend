       ACU-MAIN-LOGIC.
            PERFORM ACU-INITIAL-ROUTINE
            PERFORM ACU-EXIT-RTN.
       ACU-EXTENDED-FILE-STATUS.
            CALL "C$RERRNAME" USING ACU-ERR-FILE
            CALL "C$RERR" USING EXTEND-STAT TEXT-MESSAGE
            MOVE PRIMARY-ERROR TO ACU-MSG-ID
            PERFORM ACU-SHOW-MSG.
       ACU-SHOW-MSG.
            MOVE SPACE TO ACU-MSG-1 ACU-MSG-2 ACU-MSG-3
            EVALUATE ACU-MSG-ID
              WHEN 10
              MOVE "No more data." TO ACU-MSG-1
              MOVE MB-DEFAULT-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 22
              MOVE "Key duplication." TO ACU-MSG-1
              MOVE MB-ERROR-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 23
              MOVE "Record not found." TO ACU-MSG-1
              MOVE MB-WARNING-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 101
              MOVE "Quit?" TO ACU-MSG-1
              MOVE 4 TO ACU-ICON-TYPE
              MOVE MB-YES-NO TO ACU-BUTTON-TYPE
              WHEN 201
              MOVE "Add Record?" TO ACU-MSG-1
              MOVE 4 TO ACU-ICON-TYPE
              MOVE MB-YES-NO TO ACU-BUTTON-TYPE
              WHEN 202
              MOVE "Update Record?" TO ACU-MSG-1
              MOVE 4 TO ACU-ICON-TYPE
              MOVE MB-YES-NO TO ACU-BUTTON-TYPE
              WHEN 203
              MOVE "Delete Record?" TO ACU-MSG-1
              MOVE 4 TO ACU-ICON-TYPE
              MOVE MB-YES-NO TO ACU-BUTTON-TYPE
              WHEN 204
              MOVE "Key duplication." TO ACU-MSG-1
              MOVE MB-WARNING-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 301
              MOVE "Add Successful." TO ACU-MSG-1
              MOVE MB-DEFAULT-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 302
              MOVE "Update Successful." TO ACU-MSG-1
              MOVE MB-DEFAULT-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 303
              MOVE "Delete Successful." TO ACU-MSG-1
              MOVE MB-DEFAULT-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 401
              MOVE "Shell not found." TO ACU-MSG-1
              MOVE MB-ERROR-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN 901
              MOVE MB-WARNING-ICON TO ACU-ICON-TYPE
              MOVE MB-OK TO ACU-BUTTON-TYPE
              WHEN OTHER
              MOVE TEXT-MESSAGE TO ACU-MSG-1
              STRING "File:" ACU-ERR-FILE DELIMITED BY SPACE INTO
                ACU-MSG-2
              STRING "File status " PRIMARY-ERROR "," SECONDARY-ERROR
                DELIMITED BY SIZE INTO ACU-MSG-3
            END-EVALUATE
            PERFORM ACU-MESSAGE-BOX.
       ACU-MESSAGE-BOX.
            MOVE 1 TO ACU-TEXT-PTR
            IF ACU-MSG-1 NOT = SPACE
              MOVE 0 TO ACU-SIZE
              INSPECT ACU-MSG-1 TALLYING ACU-SIZE FOR TRAILING SPACE
              STRING ACU-MSG-1 ( 1 : ACU-LENGTH - ACU-SIZE ) DELIMITED
                BY SIZE INTO ACU-MSG-TEXT POINTER ACU-TEXT-PTR
            END-IF
            IF ACU-MSG-2 NOT = SPACE
              MOVE 0 TO ACU-SIZE
              INSPECT ACU-MSG-2 TALLYING ACU-SIZE FOR TRAILING SPACE
              IF ACU-TEXT-PTR > 1
                STRING X"0A" DELIMITED BY SIZE INTO ACU-MSG-TEXT POINTER
                  ACU-TEXT-PTR
              END-IF
              STRING ACU-MSG-2 ( 1 : ACU-LENGTH - ACU-SIZE ) DELIMITED
                BY SIZE INTO ACU-MSG-TEXT POINTER ACU-TEXT-PTR
            END-IF
            IF ACU-MSG-3 NOT = SPACE
              MOVE 0 TO ACU-SIZE
              INSPECT ACU-MSG-3 TALLYING ACU-SIZE FOR TRAILING SPACE
              IF ACU-TEXT-PTR > 1
                STRING X"0A" DELIMITED BY SIZE INTO ACU-MSG-TEXT POINTER
                  ACU-TEXT-PTR
              END-IF
              STRING ACU-MSG-3 ( 1 : ACU-LENGTH - ACU-SIZE ) DELIMITED
                BY SIZE INTO ACU-MSG-TEXT POINTER ACU-TEXT-PTR
            END-IF
            IF ACU-TEXT-PTR = 1
              MOVE 0 TO ACU-SIZE
              INSPECT ACU-MSG-TEXT TALLYING ACU-SIZE FOR TRAILING SPACE
              COMPUTE ACU-TEXT-PTR = ACU-FULL-LEN - ACU-SIZE + 1
            END-IF
            MOVE LOW-VALUES TO ACU-MSG-TEXT ( ACU-TEXT-PTR : 1 )
            DISPLAY MESSAGE BOX ACU-MSG-TEXT TYPE IS ACU-BUTTON-TYPE
              ICON IS ACU-ICON-TYPE DEFAULT IS ACU-DEFAULT-BUTTON
              RETURNING ACU-RETURN-VALUE.
       ACU-INITIAL-ROUTINE.
            ACCEPT SYSTEM-INFORMATION FROM SYSTEM-INFO
            ACCEPT TERMINAL-ABILITIES FROM TERMINAL-INFO
            PERFORM ACU-OPEN-FILES
            PERFORM REPORT1A-AFTER-INIT.
       ACU-EXIT-RTN.
            PERFORM ACU-EXIT-FONT
            PERFORM ACU-EXIT-BMP
            PERFORM ACU-CLOSE-FILES
            EXIT PROGRAM
            STOP RUN.
       ACU-EXIT-FONT.
            .
       ACU-EXIT-BMP.
            .
       ACU-OPEN-FILES.
            PERFORM ACU-OPEN-SALESDATA.
       ACU-OPEN-SALESDATA.
            OPEN INPUT SALESDATA
            IF NOT SALESDATA-STATUS ( 1 : 1 ) = "0"
              PERFORM ACU-EXTENDED-FILE-STATUS
              GO TO ACU-EXIT-RTN
            END-IF.
       ACU-CLOSE-FILES.
            CLOSE SALESDATA.
       ACU-SALESDATADS-READ.
            READ SALESDATA WITH NO LOCK KEY SALES-KEY OF SALESDATA.
       ACU-SALESDATADS-READ-NEXT.
            READ SALESDATA NEXT WITH NO LOCK.
       ACU-SALESDATADS-READ-PREV.
            READ SALESDATA PREVIOUS WITH NO LOCK.
       ACU-SALESDATADS-DELETE.
            DELETE FILE SALESDATA.
       REPORT1A-AFTER-INIT.
            PERFORM ACU-REPORT1A-PREVIEW.
       REPORT1A-BEFOREDOPRINT.
            MOVE 1 TO REPORT1A-DOPRINTRTN-LOOP.
            MOVE LOW-VALUES TO SALES-KEY.
            START SALESDATA KEY > SALES-KEY.
            READ SALESDATA NEXT RECORD AT END
            MOVE "10" TO SALESDATA-STATUS
            INITIALIZE REPORT1A-DOPRINTRTN-LOOP
            END-READ.
       REPORT1A-AFTERDOPRINT.
            READ SALESDATA NEXT RECORD AT END
            MOVE "10" TO SALESDATA-STATUS
            INITIALIZE REPORT1A-DOPRINTRTN-LOOP
            END-READ.
       ACU-REPORT1A-HTML-HEADER.
            MOVE "<HTML>" TO PRINT-BUF.
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE "<HEAD><TITLE>  </TITLE></HEAD>" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            PERFORM ACU-REPORT1A-HTML-CSS
            MOVE '<BODY STYLE="BACKGROUND-COLOR:#FFFFFF;">' TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF.
       ACU-REPORT1A-HTML-FOOTER.
            MOVE "</BODY>" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE "</HTML>" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF.
       ACU-REPORT1A-HTML-CSS.
            MOVE '<STYLE TYPE="TEXT/CSS">' TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-Header {PAGE-BREAK-BEFORE:ALWAYS; POSITION:R
      -     "ELATIVE; TOP:0; LEFT:0; WIDTH:672; HEIGHT:912}"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            MOVE
              "   .Report1a-Header-0 {POSITION:RELATIVE; TOP:0; LEFT:0; 
      -     "WIDTH:672; HEIGHT:912}"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwLa-1 {POSITION:ABSOLUTE; TOP:6; LEFT:21; W
      -     "IDTH:129; HEIGHT:18; BACKGROUND-COLOR:TRANSPARENT; }"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwEf-1 {POSITION:ABSOLUTE; TOP:6; LEFT:177; 
      -     "WIDTH:26; HEIGHT:18; BORDER-STYLE:SOLID; BORDER-WIDTH:1px; 
      -     "border-color:#000000; LETTER-SPACING:0.00; BACKGROUND-COLOR
      -     ":TRANSPARENT; OVERFLOW:HIDDEN}"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwLa-2 {POSITION:ABSOLUTE; TOP:27; LEFT:21; 
      -     "WIDTH:129; HEIGHT:18; BACKGROUND-COLOR:TRANSPARENT; }"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwEf-2 {POSITION:ABSOLUTE; TOP:27; LEFT:177;
      -     " WIDTH:38; HEIGHT:18; BORDER-STYLE:SOLID; BORDER-WIDTH:1px;
      -     " border-color:#000000; LETTER-SPACING:0.00; BACKGROUND-COLO
      -     "R:TRANSPARENT; OVERFLOW:HIDDEN}"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwLa-3 {POSITION:ABSOLUTE; TOP:48; LEFT:21; 
      -     "WIDTH:129; HEIGHT:18; BACKGROUND-COLOR:TRANSPARENT; }"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwEf-3 {POSITION:ABSOLUTE; TOP:48; LEFT:177;
      -     " WIDTH:302; HEIGHT:18; BORDER-STYLE:SOLID; BORDER-WIDTH:1px
      -     "; border-color:#000000; LETTER-SPACING:0.00; BACKGROUND-COL
      -     "OR:TRANSPARENT; OVERFLOW:HIDDEN}"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwLa-4 {POSITION:ABSOLUTE; TOP:69; LEFT:21; 
      -     "WIDTH:129; HEIGHT:18; BACKGROUND-COLOR:TRANSPARENT; }"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-RwEf-4 {POSITION:ABSOLUTE; TOP:69; LEFT:177;
      -     " WIDTH:302; HEIGHT:18; BORDER-STYLE:SOLID; BORDER-WIDTH:1px
      -     "; border-color:#000000; LETTER-SPACING:0.00; BACKGROUND-COL
      -     "OR:TRANSPARENT; OVERFLOW:HIDDEN}"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE
              "   .Report1a-Footer {POSITION:ABSOLUTE; TOP:864; LEFT:0; 
      -     "WIDTH:672}"
             TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE "</STYLE>" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF.
       ACU-REPORT1A-PRINT-PARA.
            MOVE SPACES TO PRINT-FULLNAME
            CALL "C$FULLNAME" USING "Report1a.html" PRINT-FULLNAME
              GIVING ACU-STATUS-CODE
            IF ACU-STATUS-CODE = 1
              MOVE 0 TO ACU-SETUPPRINT
              EXIT PARAGRAPH
            END-IF
            MOVE 0 TO ACU-IDX1
            INSPECT PRINT-FULLNAME TALLYING ACU-IDX1 FOR ALL "\"
            INSPECT PRINT-FULLNAME REPLACING TRAILING SPACE BY "*"
            IF ACU-IDX1 <= 0
              MOVE SPACES TO DUMY-LINE
              CALL "C$CHDIR" USING DUMY-LINE
              INSPECT DUMY-LINE REPLACING TRAILING SPACE BY "*"
              MOVE 0 TO ACU-STATUS-CODE
              PERFORM VARYING ACU-IDX2 FROM 1 BY 1 UNTIL ACU-STATUS-CODE
                = 1
              IF DUMY-LINE ( ACU-IDX2 : 1 ) = "*"
                MOVE 1 TO ACU-STATUS-CODE
              END-IF
              END-PERFORM
              IF DUMY-LINE ( ACU-IDX2 - 2 : 1 ) = "\"
                STRING DUMY-LINE PRINT-FULLNAME X"00" DELIMITED BY "*"
                  INTO PRT-FULLFILENAME
              ELSE
                STRING DUMY-LINE "\" PRINT-FULLNAME X"00" DELIMITED BY 
                "*"
                 INTO PRT-FULLFILENAME
              END-IF
            ELSE
              STRING PRINT-FULLNAME X"00" DELIMITED BY "*" INTO
                PRT-FULLFILENAME
            END-IF
            STRING "Letter" X"00" DELIMITED BY SIZE INTO ACU-PAPER-SIZE
            STRING "&w&bPage &p of &P" X"00" DELIMITED BY SIZE INTO
              ACU-PAPER-HEADER
            STRING "&u&b&d" X"00" DELIMITED BY SIZE INTO
              ACU-PAPER-FOOTER
            MOVE "PORTRAIT" TO ACU-PAPER-ORIENTATION
            IF ACU-PAPER-ORIENTATION = "LANDSCAPE"
              MOVE 2 TO ACU-PAPER-ORIENTATIONINT
            ELSE
              MOVE 1 TO ACU-PAPER-ORIENTATIONINT
            END-IF
            STRING "PORTRAIT" X"00" DELIMITED BY SIZE INTO
              ACU-PAPER-ORIENTATION
            MOVE "75" TO ACU-MARGIN-LEFT
            MOVE "75" TO ACU-MARGIN-RIGHT
            MOVE "75" TO ACU-MARGIN-TOP
            MOVE "75" TO ACU-MARGIN-BOTTOM
            STRING ACU-PAPER-MARGIN X"00" DELIMITED BY SIZE INTO
              PRINT-BROWSER-PARA
            IF ACU-PAPER-COPIES = 0 OR ACU-PAPER-COPIES ( 1 : ) = SPACES
              MOVE 1 TO ACU-PAPER-COPIES
            END-IF
            MOVE SPACES TO DUMY-LINE.
       ACU-REPORT1A-SETUP-PRINT.
            MOVE 1 TO ACU-SETUPPRINT
            PERFORM ACU-REPORT1A-PRINT-PARA
            SET ENVIRONMENT "DLL_CONVENTION" TO "1"
            CALL "AcuBenchPrintDummy" ON EXCEPTION
            CALL "AcuBenchPrint.dll"
            END-CALL
            END-CALL
            CALL "AcuBenchPrintExecWBPageSetup" USING BY CONTENT
              PRINT-BROWSER-PARA BY CONTENT ACU-PAPER-SIZE BY VALUE
              ACU-PAPER-ORIENTATIONINT BY CONTENT ACU-PRINTER-NAME
              GIVING ACUPRINTDLL-STATUS
            END-CALL
            IF ACUPRINTDLL-SUCCESS
              MOVE 1 TO PRINT-UNIT-TYPE
              SET PRINT-PTR TO ADDRESS OF ACU-PAPER-MARGIN
              CALL "AcuBenchPrintGetMargins" USING BY VALUE
                PRINT-UNIT-TYPE PRINT-PTR
              SET PRINT-PTR TO ADDRESS OF ACU-PAPER-SIZEINT
              CALL "AcuBenchPrintGetPaperSize" USING BY VALUE
                PRINT-UNIT-TYPE PRINT-PTR
              COMPUTE PAGE-HEIGHT OF REPORT1A-HEIGHT = ACU-PAPER-HEIGHT
                - ACU-MARGIN-TOP - ACU-MARGIN-BOTTOM
              COMPUTE PAGE-WIDTH OF REPORT1A-HEIGHT = ACU-PAPER-WIDTH -
                ACU-MARGIN-LEFT - ACU-MARGIN-RIGHT
              MOVE 2 TO PRINT-UNIT-TYPE
              SET PRINT-PTR TO ADDRESS OF ACU-PAPER-MARGIN
              CALL "AcuBenchPrintGetMargins" USING BY VALUE
                PRINT-UNIT-TYPE PRINT-PTR
              STRING ACU-PAPER-MARGIN X"00" DELIMITED BY SIZE INTO
                PRINT-BROWSER-PARA
              SET PRINT-PTR TO ADDRESS OF ACU-PAPER-SIZE
              CALL "AcuBenchPrintGetPaperName" USING BY VALUE PRINT-PTR
              CALL "AcuBenchPrintGetOrientation" GIVING
                ACU-PAPER-ORIENTATIONINT
              CALL "AcuBenchPrintGetCopies" GIVING ACU-PAPER-COPIES
              SET PRINT-PTR TO ADDRESS OF ACU-PRINTER-NAME
              CALL "AcuBenchPrintGetPrinterName" USING BY VALUE
                PRINT-PTR
              PERFORM ACU-REPORT1A-PRINT-TOFILE
              PERFORM ACU-REPORT1A-DO-PRINT
            END-IF.
       ACU-REPORT1A-PRINT.
            MOVE 0 TO ACU-SETUPPRINT
            PERFORM ACU-REPORT1A-PRINT-TOFILE.
       ACU-REPORT1A-PRINT-TOPDF.
           CALL "C$SYSTEM" USING "wkhtmltopdf.exe -q Report1a.html Repor
      -                          "t1a.pdf" 96     
           CALL "C$SYSTEM" USING "Report1a.pdf" 96.
       ACU-REPORT1A-DO-PRINT.
            IF ACU-SETUPPRINT = 0
              PERFORM ACU-REPORT1A-PRINT-PARA
              SET ENVIRONMENT "DLL_CONVENTION" TO "1"
              CALL "AcuBenchPrintDummy" ON EXCEPTION
              CALL "AcuBenchPrint.dll"
              END-CALL
              END-CALL
            END-IF
            CALL "AcuBenchPrintExecWBPrint" USING BY CONTENT
              PRT-FULLFILENAME OMITTED BY CONTENT PRINT-BROWSER-PARA BY
              CONTENT ACU-PAPER-HEADER BY CONTENT ACU-PAPER-FOOTER BY
              CONTENT ACU-PAPER-SIZE BY VALUE ACU-PAPER-ORIENTATIONINT
              BY VALUE ACU-PAPER-COPIES BY CONTENT ACU-PRINTER-NAME
            END-CALL
            MOVE 0 TO ACU-SETUPPRINT.
       ACU-REPORT1A-PREVIEW.
            PERFORM ACU-REPORT1A-PRINT-TOFILE
            PERFORM ACU-REPORT1A-PRINT-PARA
            PERFORM ACU-REPORT1A-PRINT-TOPDF.
      *     SET ENVIRONMENT "DLL_CONVENTION" TO "1"
      *     CALL "AcuBenchPrintDummy" ON EXCEPTION
      *     CALL "AcuBenchPrint.dll"
      *     END-CALL
      *     END-CALL
      *     CALL "AcuBenchPrintExecWBPreview" USING BY CONTENT
      *       PRT-FULLFILENAME BY CONTENT PRINT-BROWSER-PARA BY CONTENT
      *       ACU-PAPER-HEADER BY CONTENT ACU-PAPER-FOOTER BY CONTENT
      *       ACU-PAPER-SIZE BY VALUE ACU-PAPER-ORIENTATIONINT BY
      *       CONTENT ACU-PRINTER-NAME
      *     END-CALL.
       ACU-REPORT1A-PRINT-TOFILE.
            MOVE "Report1a.html" TO PTR-DEV-NAME.
            MOVE 1 TO CURRENT-COL
            MOVE 0 TO REPORT1A-CLEFTOFFSET
            MOVE 0 TO CNT-PIXELS
            MOVE 0 TO CNT-INPAGEPIXELS
            MOVE 1 TO ACU-PAGENUM
            MOVE 1 TO ACU-PAGENUM-SYS
            MOVE 1 TO NTOPCOLUMNNUM
            PERFORM ACU-PRINTF-OPEN-ROUTINE.
            PERFORM ACU-REPORT1A-HTML-HEADER.
            PERFORM ACU-REPORT1A-HTML-PAGE-HEADER.
            PERFORM ACU-RPT-REPORT1A-PRINT-LOOP.
            PERFORM ACU-REPORT1A-HTML-FOOTER.
            PERFORM ACU-PRINTF-CLOSE-ROUTINE.
       ACU-RPT-REPORT1A-PRINT-LOOP.
            MOVE 1 TO TMP-PRINTORNOT
            MOVE 0 TO SYS-ENDPRIMARYFD
            PERFORM ACU-RPT-REPORT1A-ALL-RESET
            PERFORM ACU-RPT-REPORT1A-REPORT-HEADER
            PERFORM ACU-RPT-REPORT1A-MASTER-PRINT-LOOP
            PERFORM ACU-RPT-REPORT1A-PAGE-HEADER
            PERFORM ACU-RPT-REPORT1A-GROUP-MUSTDSP
            PERFORM ACU-RPT-REPORT1A-GROUP-FOOTER
            IF ( REPORT-FOOTER-PRINT-AFTER-PAGE = 0 )
              PERFORM ACU-RPT-REPORT1A-REPORT-FOOTER
            END-IF
            PERFORM ACU-REPORT1A-FILL-DETAIL-FOR-ZEBRA
            IF ( REPORT-FOOTER-PRINT-AFTER-PAGE = 0 )
              MOVE 1 TO SYS-ENDPRIMARYFD
              COMPUTE CNT-PIXELS = ACU-PAGENUM-SYS * PAGE-HEIGHT OF
                REPORT1A-HEIGHT - REPORT1A-PF-1-DEF-HEIGHT OF
                REPORT1A-HEIGHT
              COMPUTE CNT-INPAGEPIXELS = PAGE-HEIGHT OF REPORT1A-HEIGHT
                - REPORT1A-PF-1-DEF-HEIGHT OF REPORT1A-HEIGHT
              MOVE PAGE-HEIGHT OF REPORT1A-HEIGHT TO CNT-INPAGEPIXELS
              PERFORM ACU-RPT-REPORT1A-PAGE-FOOTER
            END-IF
            IF ( REPORT-FOOTER-PRINT-AFTER-PAGE = 1 )
              PERFORM ACU-RPT-REPORT1A-REPORT-FOOTER
            END-IF.
       ACU-REPORT1A-HTML-PAGE-HEADER.
            MOVE " <!-- Page DIV -->" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            IF ACU-PAGENUM < 2
              MOVE ' <DIV CLASS="Report1a-Header-0" >' TO PRINT-BUF
            ELSE
              MOVE ' <DIV CLASS="Report1a-Header" >' TO PRINT-BUF
            END-IF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF.
       ACU-REPORT1A-HTML-PAGE-FOOTER.
            MOVE " <!-- End(Page) --></DIV>" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF.
       ACU-RPT-REPORT1A-REPORT-HEADER.
            .
       ACU-RPT-REPORT1A-REPORT-FOOTER.
            .
       ACU-RPT-REPORT1A-PAGE-HEADER.
            IF ( CNT-INPAGEPIXELS < REPORT1A-PH-1-HEIGHT OF
                REPORT1A-HEIGHT ) OR ( REPORT-HEADER-PRINT-BEFORE-PAGE =
                1 )
              PERFORM ACU-REPORT1A-PH-1-PRINT-RTN
              ADD REPORT1A-PH-1-HEIGHT OF REPORT1A-HEIGHT TO CNT-PIXELS
              IF ( REPORT-HEADER-PRINT-BEFORE-PAGE = 1 )
                ADD REPORT1A-PH-1-HEIGHT OF REPORT1A-HEIGHT TO
                  CNT-INPAGEPIXELS
              ELSE
                MOVE REPORT1A-PH-1-HEIGHT OF REPORT1A-HEIGHT TO
                  CNT-INPAGEPIXELS
              END-IF
            END-IF.
       ACU-RPT-REPORT1A-PAGE-FOOTER.
            COMPUTE TMP-PIXELS = CNT-INPAGEPIXELS + CURRENT-HEIGHT +
              REPORT1A-PF-1-HEIGHT OF REPORT1A-HEIGHT
            IF TMP-PIXELS > PAGE-HEIGHT OF REPORT1A-HEIGHT
              COMPUTE CNT-PIXELS = ACU-PAGENUM-SYS * PAGE-HEIGHT OF
                REPORT1A-HEIGHT - REPORT1A-PF-1-HEIGHT OF
                REPORT1A-HEIGHT
              COMPUTE CNT-INPAGEPIXELS = PAGE-HEIGHT OF REPORT1A-HEIGHT
                - REPORT1A-PF-1-DEF-HEIGHT OF REPORT1A-HEIGHT
              PERFORM ACU-REPORT1A-PF-1-PRINT-RTN
              PERFORM ACU-REPORT1A-PAGE-BREAK-RTN
              MOVE REPORT1A-PF-1-DEF-HEIGHT OF REPORT1A-HEIGHT TO
                REPORT1A-PF-1-HEIGHT OF REPORT1A-HEIGHT
            END-IF.
       ACU-RPT-REPORT1A-PAGE-FOOTER-OVERPAGE.
            MOVE 0 TO RPT-RETURN-VALUE
            COMPUTE TMP-PIXELS = CNT-INPAGEPIXELS + CURRENT-HEIGHT +
              REPORT1A-PF-1-HEIGHT OF REPORT1A-HEIGHT
            IF TMP-PIXELS + 1 >= PAGE-HEIGHT OF REPORT1A-HEIGHT
              MOVE 1 TO RPT-RETURN-VALUE
            END-IF.
       ACU-RPT-REPORT1A-DETAIL.
            PERFORM ACU-REPORT1A-DTL-1-DETAIL-PRINT.
            .
       ACU-RPT-REPORT1A-GROUP-HEADER.
            .
       ACU-RPT-REPORT1A-GROUP-FOOTER.
            .
       ACU-RPT-REPORT1A-GROUP-MUSTDSP.
            .
       ACU-RPT-REPORT1A-GROUP-NOMUSTDSP.
            .
       ACU-RPT-REPORT1A-ALL-RESET.
            .
       ACU-RPT-REPORT1A-DO-PRINT-RTN.
            MOVE 1 TO TMP-PRINTORNOT
            PERFORM ACU-RPT-REPORT1A-GROUP-FOOTER
            MOVE REPORT1A-DTL-1-HEIGHT OF REPORT1A-HEIGHT TO
              CURRENT-HEIGHT
            PERFORM ACU-RPT-REPORT1A-PAGE-FOOTER
            PERFORM ACU-RPT-REPORT1A-PAGE-HEADER
            PERFORM ACU-RPT-REPORT1A-GROUP-HEADER
            PERFORM ACU-RPT-REPORT1A-DETAIL.
       ACU-REPORT1A-PAGE-BREAK-RTN.
            IF CURRENT-COL < NTOPCOLUMNNUM
              COMPUTE CNT-PIXELS = ( ACU-PAGENUM-SYS - 1 ) * PAGE-HEIGHT
                OF REPORT1A-HEIGHT
              COMPUTE REPORT1A-CLEFTOFFSET = REPORT1A-CLEFTOFFSET +
                DETAIL-WIDTH
              MOVE 0 TO CNT-INPAGEPIXELS
              ADD 1 TO CURRENT-COL
            ELSE
              COMPUTE CNT-PIXELS = ACU-PAGENUM-SYS * PAGE-HEIGHT OF
                REPORT1A-HEIGHT
              MOVE 0 TO REPORT1A-CLEFTOFFSET
              MOVE 0 TO CNT-INPAGEPIXELS
              ADD 1 TO ACU-PAGENUM-SYS
              ADD 1 TO ACU-PAGENUM
              MOVE 1 TO CURRENT-COL
            END-IF
            PERFORM ACU-REPORT1A-HTML-PAGE-FOOTER
            IF SYS-ENDPRIMARYFD = 0
              PERFORM ACU-REPORT1A-HTML-PAGE-HEADER
            END-IF.
       ACU-REPORT1A-FILL-DETAIL-FOR-ZEBRA.
            .
       ACU-REPORT1A-ZEBRA-COLOR-CHANGE.
            .
       ACU-REPORT1A-DTL-1-DETAIL-PRINT.
            MOVE 816 TO DETAIL-WIDTH
            MOVE REPORT1A-DTL-1-HEIGHT OF REPORT1A-HEIGHT TO
              CURRENT-HEIGHT
            PERFORM ACU-RPT-REPORT1A-PAGE-FOOTER
            PERFORM ACU-RPT-REPORT1A-PAGE-HEADER
            PERFORM ACU-REPORT1A-DTL-1-PRINT-RTN
            ADD REPORT1A-DTL-1-HEIGHT OF REPORT1A-HEIGHT TO CNT-PIXELS
            ADD REPORT1A-DTL-1-HEIGHT OF REPORT1A-HEIGHT TO
              CNT-INPAGEPIXELS
            MOVE REPORT1A-DTL-1-DEF-HEIGHT OF REPORT1A-HEIGHT TO
              REPORT1A-DTL-1-HEIGHT OF REPORT1A-HEIGHT
            PERFORM ACU-REPORT1A-ZEBRA-COLOR-CHANGE.
       ACU-REPORT1A-PH-1-SEC-HEAD.
            MOVE "   <!-- Section (Report1a-PH-1) -->" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            COMPUTE TMP-PIXELS = CNT-INPAGEPIXELS - HIGH-OFFSET-IN
            STRING '   <DIV STYLE="' "POSITION:ABSOLUTE; TOP:"
              TMP-PIXELS "; LEFT:0" "; WIDTH:816; " "FONT-SIZE:9pt; "
              "FONT-FAMILY:MS Sans Serif; " "COLOR:#000000; "
              "BACKGROUND-COLOR:#FFFFFF; " '">' DELIMITED BY SIZE INTO
              PRINT-BUF.
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF.
       ACU-REPORT1A-PH-1-SEC-FOOT.
            MOVE "      <!-- Ending DIV : to fill the Div Height -->" TO
              PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            STRING '      <DIV STYLE="POSITION:RELATIVE; HEIGHT:'
              REPORT1A-PH-1-HEIGHT OF REPORT1A-HEIGHT ';"> </DIV>'
              DELIMITED BY SIZE INTO PRINT-BUF.
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
            MOVE "   <!-- End(Section) --></DIV>" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001.
       ACU-REPORT1A-PH-1-PRINT-RTN.
            MOVE 0 TO SECTION-HIGH-STACK
            MOVE REPORT1A-PH-1-DEF-HEIGHT TO REPORT1A-PH-1-HEIGHT
            PERFORM ACU-REPORT1A-PH-1-SEC-HEAD
            PERFORM ACU-REPORT1A-PH-1-SEC-FOOT.
       ACU-REPORT1A-DTL-1-SEC-HEAD.
            MOVE "   <!-- Section (Report1a-Dtl-1) -->" TO PRINT-BUF
            WRITE PRINTF-R FROM PRINT-BUF AFTER 001
            INITIALIZE PRINT-BUF
