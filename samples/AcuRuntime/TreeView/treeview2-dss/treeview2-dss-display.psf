{{@PARAGRAPH:
      *
       Screen1-Aft-Initdata.
           modify Screen1-La-2, title = ws-saved-text
           .
      *
       Screen1-Pb-1-Link.
           destroy screen1
           chain "treeview2-dss" 
                 using ws-saved-text 
                       ws-saved-parent-text 
                       Screen1-Cb-1-Value
           .

@}}

