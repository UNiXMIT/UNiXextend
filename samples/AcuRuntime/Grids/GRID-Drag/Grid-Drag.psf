{{@PARAGRAPH:
      *
       Screen1-Gd-1-Ev-Msg-Begin-Drag.
           continue
           .
      *
       Screen1-Gd-1-Ev-Msg-End-Drag. 
           inquire Screen1-Gd-1, CELL-DATA in ws-end-value 
           display message box "Msg-End-Drag"  
                               x"0d0a"
                               "Da: " ws-y "-" ws-x 
                               " (" ws-start-value ")"
                               x"0d0a"
                               "A:  " EVENT-DATA-2 "-" EVENT-DATA-1 
                               " (" ws-end-value ")"
           .
      *
       Screen1-Gd-1-Ev-Msg-Goto-Cell-Drag.
      *     MODIFY Screen1-Gd-1 (EVENT-DATA-2, EVENT-DATA-1),
      *            CELL-DATA = "Selected"      
           continue
           .
      *
       Screen1-Gd-1-Ev-Msg-Goto-Cell-Mouse.
           inquire Screen1-Gd-1, x in ws-x, y in ws-y, 
                                 CELL-DATA in ws-start-value
      *     modify Screen1-Gd-1 (ws-y, ws-x), 
      *            CELL-DATA = "Msg-Goto-Cell-Mouse"
           .
      *
       Screen1-Aft-Create.
           move "               2       3       4       5       6       
      -    "7       8       9      10" to Screen1-Gd-1-Record
           modify Screen1-Gd-1, RECORD-TO-ADD Screen1-Gd-1-Record 

           move "       B      B2      B3      B4      B5      B6      B
      -    "7      B8      B9     B10" to Screen1-Gd-1-Record
           modify Screen1-Gd-1, RECORD-TO-ADD Screen1-Gd-1-Record  

           move "       C      C2      C3      C4      C5      C6      C
      -    "7      C8      C9     C10" to Screen1-Gd-1-Record
           modify Screen1-Gd-1, RECORD-TO-ADD Screen1-Gd-1-Record   

           move "       D      D2      D3      D4      D5      D6      D
      -    "7      D8      D9     D10" to Screen1-Gd-1-Record
           modify Screen1-Gd-1, RECORD-TO-ADD Screen1-Gd-1-Record    

           move "       E      E2      E3      E4      E5      E6      E
      -    "7      E8      E9     E10" to Screen1-Gd-1-Record
           modify Screen1-Gd-1, RECORD-TO-ADD Screen1-Gd-1-Record     

           move "       F      F2      F3      F4      F5      F6      F
      -    "7      F8      F9     F10" to Screen1-Gd-1-Record
           modify Screen1-Gd-1, RECORD-TO-ADD Screen1-Gd-1-Record     

           move "       G      G2      G3      G4      G5      G6      G
      -    "7      G8      G9     G10" to Screen1-Gd-1-Record
           modify Screen1-Gd-1, RECORD-TO-ADD Screen1-Gd-1-Record
           .

@}}

