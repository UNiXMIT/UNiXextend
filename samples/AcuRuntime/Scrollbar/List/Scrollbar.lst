      ***   start event editor code   ***
      *
       Form1-Sb-1-Ev-Msg-Sb-Next.
000560     if ws-scroll-value <= ws-max-line-length - ws-size
00056D             add 1 to ws-scroll-value
           end-if
000572         perform redraw-sb-lb
           .
      *
       Form1-Sb-1-Ev-Msg-Sb-Prev.
00057A     if ws-scroll-value > 1
000584             subtract 1 from ws-scroll-value
           end-if
000589         perform redraw-sb-lb
           .
      *
       Form1-Sb-1-Ev-Msg-Sb-Nextpage.
000591     if ws-scroll-value + (ws-size * 2)
                             < ws-max-line-length
0005A1             add ws-size to ws-scroll-value
               else
0005AA             compute ws-scroll-value =
                   ws-max-line-length + 1 - ws-size
           end-if
0005B6         perform redraw-sb-lb
           .
      *
       Form1-Sb-1-Ev-Msg-Sb-Prevpage.
0005BE     if ws-scroll-value - ws-size > 1
0005CB            subtract ws-size from ws-scroll-value
           else
0005D8             compute ws-scroll-value = 1
           end-if
0005DE         perform redraw-sb-lb
           .
      *
       Form1-Sb-1-Ev-Msg-Sb-Thumbtrack.
0005E6     if evento-data-2 > 0
0005F1              move evento-data-2 to ws-scroll-value
           end-if
0005F8         perform redraw-sb-lb
           .
       redraw-sb-lb.
000600     modify Form1-Sb-1,    value = ws-scroll-value.
00060E     perform reload-listbox.

