{{@PARAGRAPH:
      *
       Screen1-Pb-1-Ev-Cmd-Clicked.
           string "https://api.qrserver.com/v1/create-qr-code/?size=150x
      -           "150&data="
                  Screen1-Ef-1-Value
                  into
                  Screen2-Wb-1-Value
           perform Acu-Screen2-Routine
           .
      *
       Screen2-Aft-Create.
           MOVE 4 to ACCEPT-CONTROL.
           MOVE 99 to CONTROL-ID.
           MODIFY Screen2-Wb-1, VISIBLE TRUE
           .
      *
@}}

