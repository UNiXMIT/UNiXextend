[PROJECT_COMPILE_SETTING-NewBookSF:Debug Mode]
; Standard Options
NAME_OBJECT_FILE=.\object\@.acu
NAME_ERROR_FILE=@.err
MAX_ERROR_COUNT_NUM=100
REMOTE_SERVER_NAME=myserver
REMOTE_SERVER_PORT=5632
REMOTE_SERVER_DIR=/
REMOTE_OBJECT_FILE=@.acu
; Listing Options
NAME_LISTING_FILE=.\list\@.lst
; Compatibility Options
; File Options
GEN_XFD_FILE=1
XFD_FILE_VERSION=0
; Source Options
SOURCE_FORMAT_TYPE=2
; ReservedWord Options
; DataStorage Options
ALIGNMENT_DATA_BOUNDARY=4
SYNC_BOUNDARY_LIMIT_NUMBER=4
; Video Options
; Mapping Options
; Precompiler Options
NAME_PRECOMPILE_OUTPUT_FILE=.\list\@.asq
; Native Code Options
; Debugger Options
INCLUDE_ALL_INFO=1
; Interop Options
; Miscellaneous Options
DEBUGGING=1
CODE_VERSION_NUMBER=61

[PROJECT_RUNTIME_SETTING-NewBookSF:Debug Mode]
ADDITIONAL_OPTIONS=--analyze
; Common Options
NAME_CONFIGURATION_FILE=.\cblconfi
; Io Options
; Debug Options
; ThinClient Options
REMOTE_CONFIG_NAME=myserver:5632:/etc/cblconfig
REMOTE_CONFIG_DEBUG=0
REMOTE_CONFIG_DEBUG_PORT=5632

[PROJECT_ENVIRONMENT_SETTING-NewBookSF:Debug Mode]
VARIABLE0=RUNNAME,Wrun32.exe
VARIABLE1=COMPILERNAME,Ccbl32.exe
VARIABLE2=CODE_PREFIX,.\object
VARIABLE3=ACUPATH,c:\program files (x86)\micro focus\extend 10.2.1\acugt\bin
VARIABLE4=COPYPATH,.\screen;.\copylib;.\report;.\resource;.\fd;%sampledir%\sample\def;%screendir%;%reportdir%;%copydir%;%layoutdir%
VARIABLE5=THINNAME,AcuThin.exe

[PROJECT_LIBRARY_SETTING-NewBookSF:Debug Mode]
